# Mẫu biến môi trường — chép thành .env rồi điền giá trị thật. KHÔNG commit .env.
# Trên VPS: /opt/his/.env (chmod 600). Máy dev: .env ở gốc repo.
# compose.yaml chuyển từng biến vào container backend (4-docker-compose/docker-compose.md mục 4).

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=doi-mat-khau-root
MYSQL_DATABASE=his
MYSQL_USER=his
MYSQL_PASSWORD=doimatkhauhis

# ---- JWT (chuỗi ngẫu nhiên >= 32 ký tự; tạo bằng: openssl rand -base64 48) ----
HIS_JWT_KEY=thay-bang-chuoi-ngau-nhien-it-nhat-32-ky-tu
HIS_JWT_ISSUER=his-api
HIS_JWT_AUDIENCE=his-frontend

# ---- Admin gốc (chỉ dùng khi CSDL chưa có Admin) ----
HIS_SEED_ADMIN_EMAIL=admin@nangnguyen.me
HIS_SEED_ADMIN_SO_DIEN_THOAI=0900000000
HIS_SEED_ADMIN_MAT_KHAU=doi-mat-khau-admin

# ---- Frontend, CORS, Swagger ----
HIS_FRONTEND_URL=https://nangnguyen.me
HIS_CORS_ALLOWED_ORIGINS=https://nangnguyen.me,https://www.nangnguyen.me
HIS_SWAGGER_ENABLED=true

# ---- Cloudflare R2 (bucket dev ở máy dev, bucket prod trên VPS) ----
HIS_R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
HIS_R2_ACCESS_KEY=
HIS_R2_SECRET_KEY=
HIS_R2_BUCKET=thehos-prod

# ---- VNPAY sandbox (tài khoản merchant của nhóm — KHÔNG dùng khóa trong repo TheDuck) ----
HIS_VNPAY_TMN_CODE=
HIS_VNPAY_HASH_SECRET=
HIS_VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
HIS_VNPAY_RETURN_URL=https://nangnguyen.me/thanh-toan/ket-qua

# ---- Email OTP ----
# Trên VPS (DigitalOcean chặn cổng 25/465/587): Brevo SMTP relay cổng 2525.
#   SPRING_MAIL_USERNAME = "SMTP login" (dạng ...@smtp-brevo.com), SPRING_MAIL_PASSWORD = SMTP key của Brevo,
#   HIS_EMAIL_NGUOI_GUI  = địa chỉ gửi đã xác minh ở Brevo (vd no-reply@nangnguyen.me).
# Máy dev muốn dùng Gmail: smtp.gmail.com, 587, Gmail + App Password, để trống HIS_EMAIL_NGUOI_GUI.
SPRING_MAIL_HOST=smtp-relay.brevo.com
SPRING_MAIL_PORT=2525
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
HIS_EMAIL_NGUOI_GUI=no-reply@nangnguyen.me

# ---- LLM (giai đoạn AI — chưa dùng) ----
# HIS_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# HIS_LLM_API_KEY=
