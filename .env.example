# Mẫu biến môi trường — chép thành .env rồi điền giá trị thật. KHÔNG commit .env.
# Trên EC2: /opt/his/.env (tạo tay). Máy dev: .env ở gốc repo.
# Mật khẩu MySQL chỉ dùng chữ và số (được ghép vào connection string trong compose.yaml).

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=doi-mat-khau-root
MYSQL_DATABASE=his
MYSQL_USER=his
MYSQL_PASSWORD=doimatkhauhis

# ---- JWT (chuỗi ngẫu nhiên >= 32 ký tự) ----
Jwt__Key=thay-bang-chuoi-ngau-nhien-it-nhat-32-ky-tu
Jwt__Issuer=his-api
Jwt__Audience=his-frontend

# ---- Admin gốc (chỉ dùng khi CSDL chưa có Admin) ----
Seed__AdminEmail=admin@nangnguyen.me
Seed__AdminSoDienThoai=0900000000
Seed__AdminMatKhau=doi-mat-khau-admin

# ---- CORS + Swagger ----
Cors__AllowedOrigins=https://nangnguyen.me,http://localhost:5173
Swagger__Enabled=true

# ---- Cloudflare R2 (bucket dev ở máy dev, bucket prod trên EC2) ----
R2__ServiceURL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2__AccessKey=
R2__SecretKey=
R2__Bucket=thehos-dev

# ---- VNPAY sandbox ----
Vnpay__TmnCode=
Vnpay__HashSecret=
Vnpay__PayUrl=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
Vnpay__ReturnUrl=https://nangnguyen.me/thanh-toan/ket-qua

# ---- Gmail SMTP (App Password) ----
Smtp__Host=smtp.gmail.com
Smtp__Port=587
Smtp__User=
Smtp__AppPassword=

# ---- LLM: Gemini chính, Groq dự phòng (OpenAI-compatible) ----
Llm__BaseUrl=https://generativelanguage.googleapis.com/v1beta/openai/
Llm__ApiKey=
Llm__Model=gemini-2.5-flash
LlmDuPhong__BaseUrl=https://api.groq.com/openai/v1/
LlmDuPhong__ApiKey=
LlmDuPhong__Model=llama-3.3-70b-versatile
